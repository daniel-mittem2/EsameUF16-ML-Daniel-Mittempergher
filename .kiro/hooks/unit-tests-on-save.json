{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Unit Tests on Python Save",
      "trigger": "PostFileSave",
      "matcher": "Exam[\\\\/]techconf-exam[\\\\/]services[\\\\/][^\\\\/]+[\\\\/].*\\.py$",
      "action": {
        "type": "command",
        "command": "py -3.12 .kiro/scripts/run_unit_tests.py"
      }
    }
  ]
}
